#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x_id=0) in;
layout(push_constant) uniform Params { uint n; uint loops; uint seed; uint offset; } p;
layout(binding=0) readonly buffer A { AT a[]; };
layout(binding=1) readonly buffer B { AT b[]; };
layout(binding=3) writeonly buffer D { CT d[]; };
// FEED selects where A/B come from inside the loop:
//  0: register-resident (loaded once before the loop): matrix-unit throughput only.
//  1: coopMatLoad from workgroup memory every iteration (TILES tile pairs staged once).
//  2: coopMatLoad from the storage buffer every iteration; p.n tile pairs, tile
//     (subgroup_global*loops + i) % p.n, so p.n selects cache-resident vs DRAM
//     streaming. Every subgroup reads its own tiles: with a shared index the other
//     subgroups of a workgroup would hit in cache and inflate the DRAM-fed rate.
// Each loaded pair feeds CHAINS multiply-adds, so CHAINS is the reuse per load.
#ifndef FEED
#define FEED 0
#endif
#if FEED==1
shared AT sa[TILES*M*K];
shared AT sb[TILES*K*N];
#endif
void main(){
 coopmat<AT,gl_ScopeSubgroup,M,K,gl_MatrixUseA> ma;
 coopmat<AT,gl_ScopeSubgroup,K,N,gl_MatrixUseB> mb;
 coopmat<CT,gl_ScopeSubgroup,M,N,gl_MatrixUseAccumulator> acc[CHAINS];
 coopMatLoad(ma,a,0,K,gl_CooperativeMatrixLayoutRowMajor);
 coopMatLoad(mb,b,0,N,gl_CooperativeMatrixLayoutRowMajor);
#if FEED==1
 for(uint j=gl_LocalInvocationIndex;j<TILES*M*K;j+=gl_WorkGroupSize.x)sa[j]=a[j];
 for(uint j=gl_LocalInvocationIndex;j<TILES*K*N;j+=gl_WorkGroupSize.x)sb[j]=b[j];
 memoryBarrierShared();barrier();
#endif
 [[unroll]]for(uint c=0;c<CHAINS;c++)acc[c]=coopmat<CT,gl_ScopeSubgroup,M,N,gl_MatrixUseAccumulator>(CT(c));
 for(uint i=0;i<p.loops;i++){
#if FEED==1
 uint tile=(gl_WorkGroupID.x+gl_SubgroupID+i)%TILES;
 coopMatLoad(ma,sa,tile*(M*K),K,gl_CooperativeMatrixLayoutRowMajor);
 coopMatLoad(mb,sb,tile*(K*N),N,gl_CooperativeMatrixLayoutRowMajor);
#elif FEED==2
 uint tile=((gl_WorkGroupID.x*gl_NumSubgroups+gl_SubgroupID)*p.loops+i)%p.n;
 coopMatLoad(ma,a,tile*(M*K),K,gl_CooperativeMatrixLayoutRowMajor);
 coopMatLoad(mb,b,tile*(K*N),N,gl_CooperativeMatrixLayoutRowMajor);
#endif
 [[unroll]]for(uint c=0;c<CHAINS;c++)acc[c]=coopMatMulAdd(ma,mb,acc[c]);
 }
 [[unroll]]for(uint c=0;c<CHAINS;c++)coopMatStore(acc[c],d,((gl_WorkGroupID.x*gl_NumSubgroups+gl_SubgroupID)*CHAINS+c)*M*N,N,gl_CooperativeMatrixLayoutRowMajor);
}
