#version 450
// v2 workgroup-memory bandwidth, textbook bank-conflict form:
//  OP 0 read : one fill + one barrier, then ACC independent accumulators so the
//              loop is throughput-bound, not bound by a single add dependency.
//  OP 2 write: pure stores (volatile-annotated at SPIR-V level so they are not
//              dead-store eliminated), one barrier, one cross-lane readback.
// The fill uses a rotated producer ((i+1)%COUNT) so no lane reads its own store.
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : require
layout(local_size_x_id=0) in;
layout(constant_id=1) const uint COUNT=1024;
layout(constant_id=2) const uint STRIDE=1;
layout(push_constant) uniform Params { uint n; uint loops; uint seed; uint offset; } p;
layout(binding=3) writeonly buffer D { float d[]; };
layout(binding=0) readonly buffer A { float a[]; };
#ifndef ACC
#define ACC 8
#endif
shared T data[COUNT];
void main(){
 uint l=gl_LocalInvocationID.x,w=gl_WorkGroupSize.x;
#if OP==0
 for(uint i=l;i<COUNT;i+=w){
#if WIDTH==1
  data[(i+1)%COUNT]=T(a[(i+1)%COUNT]);
#else
  T x;for(uint v=0;v<WIDTH;v++)x[v]=S(a[((i+1)%COUNT)*WIDTH+v]);data[(i+1)%COUNT]=x;
#endif
 }
 memoryBarrierShared();barrier();
 T acc[ACC];
 [[unroll]]for(uint k=0;k<ACC;k++)acc[k]=T(0.0);
 uint base=l*STRIDE;
 for(uint t=0;t<p.loops;t++){
  [[unroll]]for(uint k=0;k<ACC;k++)acc[k]+=data[(base+(t*ACC+k)*w)%COUNT];
 }
 T sum=T(0.0);
 [[unroll]]for(uint k=0;k<ACC;k++)sum+=acc[k];
#else
 uint slot=(l*STRIDE)%COUNT;
 for(uint t=0;t<p.loops;t++){
  [[unroll]]for(uint k=0;k<ACC;k++)data[slot]=T(float((t*ACC+k)&15u));
 }
 memoryBarrierShared();barrier();
 T sum=data[(((l+1)%w)*STRIDE)%COUNT];
#endif
#if WIDTH==1
 d[gl_GlobalInvocationID.x]=float(sum);
#else
 for(uint v=0;v<WIDTH;v++)d[gl_GlobalInvocationID.x*WIDTH+v]=float(sum[v]);
#endif
}
