# Perfetto config: GPU/CPU frequency, scheduling, thermal and GPU memory on an
# Android phone, for lining up a roofline run with DVFS and thermal state.
# Usage: docs/TOOLING.md#perfetto. Raise duration_ms to cover a whole stage.
duration_ms: 5000
buffers { size_kb: 65536 fill_policy: RING_BUFFER }
data_sources { config { name: "linux.ftrace" ftrace_config {
  ftrace_events: "power/gpu_frequency"
  ftrace_events: "power/cpu_frequency"
  ftrace_events: "gpu_mem/gpu_mem_total"
  ftrace_events: "sched/sched_switch"
  ftrace_events: "thermal/thermal_temperature"
  ftrace_events: "mali/*"
  ftrace_events: "gpu_scheduler/*"
} } }
# Not registered on the Pixel 7a or the S24+ as of 2026-09-25; harmless when absent.
data_sources { config { name: "gpu.counters" gpu_counter_config { counter_period_ns: 1000000 } } }
data_sources { config { name: "gpu.renderstages" } }
data_sources { config { name: "android.gpu.memory" } }
